                                            </div>
                                            <input type="number" id="p-promo-price" min="0" class="w-full pl-10 px-3 py-2 border border-red-300 rounded-md focus:ring-red-500 focus:border-red-500 outline-none text-sm bg-red-50 transition" placeholder="Misal: 12000000">
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Tautan Foto Produk (URL) *</label>
                                        <div class="flex rounded-md shadow-sm">
                                            <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-gray-300 bg-gray-50 text-gray-500 sm:text-sm">
                                                <i class="fas fa-link"></i>
                                            </span>
                                            <input type="url" id="p-image" required class="flex-1 min-w-0 block w-full px-3 py-2 rounded-none rounded-r-md border border-gray-300 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition" placeholder="https://contoh.com/gambar.jpg">
                                        </div>
                                        <p class="text-xs text-gray-500 mt-1">Gunakan URL foto publik untuk menampilkan gambar.</p>
                                    </div>

                                    <div class="mb-6">
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Deskripsi & Keunggulan</label>
                                        <textarea id="p-desc" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition" placeholder="Jelaskan spesifikasi dan keunggulan teknologi terbarunya..."></textarea>
                                    </div>

                                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-md shadow-md transition flex items-center justify-center">
                                        <i class="fas fa-paper-plane mr-2"></i> Publikasikan Sekarang
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Product Management List -->
                        <div class="xl:col-span-2">
                            <div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
                                <div class="px-6 py-4 border-b border-gray-200 bg-white flex justify-between items-center">
                                    <h3 class="text-lg font-semibold text-gray-800">Daftar Inventaris Terpublikasi</h3>
                                    <span class="bg-blue-100 text-blue-800 text-xs px-3 py-1 rounded-full font-bold" id="product-count-badge">0 item</span>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Info Produk</th>
                                                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Harga & Status</th>
                                                <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">Tindakan</th>
                                            </tr>
                                        </thead>
                                        <tbody id="admin-product-list" class="bg-white divide-y divide-gray-100">
                                            <!-- List populated by JS -->
                                        </tbody>
                                    </table>
                                    
                                    <!-- Empty state for table -->
                                    <div id="admin-empty-state" class="hidden text-center py-16 bg-gray-50">
                                        <i class="fas fa-folder-open text-4xl text-gray-300 mb-3"></i>
                                        <p class="text-gray-500 font-medium">Belum ada barang di inventaris.</p>
                                        <p class="text-gray-400 text-sm mt-1">Gunakan formulir untuk mempublikasikan barang elektronik baru. Gunakan Sinkronisasi Cloud untuk penyimpanan awan.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>

    </main>

