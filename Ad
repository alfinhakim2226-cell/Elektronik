                    <button class="bg-white px-6 py-2 rounded-full shadow-sm border hover:border-blue-500 text-gray-600 font-medium whitespace-nowrap">Smart Home</button>
                    <button class="bg-white px-6 py-2 rounded-full shadow-sm border hover:border-blue-500 text-gray-600 font-medium whitespace-nowrap">TV & Audio</button>
