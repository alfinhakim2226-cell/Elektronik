                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
                    <h1 class="text-4xl tracking-tight font-extrabold sm:text-5xl md:text-6xl mb-4">
                        <span class="block">Teknologi Terbaru 2026,</span>
                        <span class="block text-yellow-300">Harga Terbaik.</span>
