            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-blue-700">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <button onclick="switchView('storefront'); toggleMobileMenu()" class="block w-full text-left hover:bg-blue-600 px-3 py-2 rounded-md text-base font-medium">Beranda</button>
                <button onclick="switchView('promo'); toggleMobileMenu()" class="block w-full text-left hover:bg-blue-600 px-3 py-2 rounded-md text-base font-medium text-yellow-300"><i class="fas fa-tags mr-1"></i> Promo Terkini</button>
                <button id="mobile-nav-admin-login" onclick="switchView('admin-login'); toggleMobileMenu()" class="block w-full text-left bg-blue-800 hover:bg-blue-900 px-3 py-2 rounded-md text-base font-medium mt-2"><i class="fas fa-user-lock mr-1"></i> Admin Login</button>
