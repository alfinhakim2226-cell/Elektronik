<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ElectroHub - Toko Elektronik Promo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Custom Styles */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6; /* Tailwind gray-100 */
        }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }

        /* Hide elements by default */
        .hidden { display: none !important; }

        /* Notification Toast */
        #toast {
            visibility: hidden;
            min-width: 250px;
            margin-left: -125px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 8px;
            padding: 16px;
            position: fixed;
            z-index: 50;
            left: 50%;
            bottom: 30px;
            font-size: 17px;
            transition: visibility 0.5s, bottom 0.5s, opacity 0.5s;
            opacity: 0;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        #toast.show {
            visibility: visible;
            opacity: 1;
            bottom: 50px;
        }
        #toast.success { background-color: #10B981; } /* Emerald 500 */
        #toast.error { background-color: #EF4444; } /* Red 500 */

    </style>
</head>
<body class="text-gray-800 antialiased min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav class="bg-blue-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center cursor-pointer" onclick="switchView('storefront')">
                    <i class="fas fa-bolt text-yellow-300 text-2xl mr-2"></i>
                    <span class="font-bold text-xl tracking-wide">ElectroHub</span>
                </div>
                
                <!-- Desktop Menu -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <button onclick="switchView('storefront')" class="hover:bg-blue-700 px-3 py-2 rounded-md text-sm font-medium transition">Beranda</button>
                        <button onclick="switchView('promo')" class="hover:bg-blue-700 px-3 py-2 rounded-md text-sm font-medium transition text-yellow-300"><i class="fas fa-tags mr-1"></i> Promo Terkini</button>
                        <button id="nav-admin-login" onclick="switchView('admin-login')" class="bg-blue-800 hover:bg-blue-900 px-3 py-2 rounded-md text-sm font-medium transition border border-blue-500"><i class="fas fa-user-lock mr-1"></i> Admin Login</button>
                        <button id="nav-admin-dashboard" onclick="switchView('admin-dashboard')" class="hidden bg-indigo-700 hover:bg-indigo-800 px-3 py-2 rounded-md text-sm font-medium transition border border-indigo-500"><i class="fas fa-chart-line mr-1"></i> Dashboard Admin</button>
                        <button id="nav-admin-logout" onclick="logout()" class="hidden bg-red-600 hover:bg-red-700 px-3 py-2 rounded-md text-sm font-medium transition border border-red-500"><i class="fas fa-sign-out-alt mr-1"></i> Keluar</button>
                    </div>
                </div>

                <!-- Mobile menu button -->
                <div class="-mr-2 flex md:hidden">
