                    <h3 class="text-lg font-semibold mb-4 text-gray-100">Hubungi Kami</h3>
                    <ul class="space-y-3 text-sm text-gray-400">
                        <li class="flex items-center"><i class="fas fa-envelope w-6 text-blue-500"></i> hello@electrohub.id</li>
                        <li class="flex items-center"><i class="fas fa-headset w-6 text-blue-500"></i> 1500-TECH (8324)</li>
                        <li class="flex space-x-4 mt-5">
                            <a href="#" class="bg-gray-800 p-2 rounded-full text-gray-400 hover:text-white hover:bg-blue-600 transition w-10 h-10 flex items-center justify-center"><i class="fab fa-instagram text-lg"></i></a>
                            <a href="#" class="bg-gray-800 p-2 rounded-full text-gray-400 hover:text-white hover:bg-blue-600 transition w-10 h-10 flex items-center justify-center"><i class="fab fa-facebook-f text-lg"></i></a>
                            <a href="#" class="bg-gray-800 p-2 rounded-full text-gray-400 hover:text-white hover:bg-blue-600 transition w-10 h-10 flex items-center justify-center"><i class="fab fa-tiktok text-lg"></i></a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-800 pt-6 text-center text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center">
                <p>&copy; 2026 ElectroHub Indonesia. Hak Cipta Dilindungi.</p>
                <div class="mt-4 md:mt-0 flex space-x-4">
                    <i class="fab fa-cc-visa text-2xl opacity-50 hover:opacity-100 transition cursor-pointer"></i>
                    <i class="fab fa-cc-mastercard text-2xl opacity-50 hover:opacity-100 transition cursor-pointer"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- Global Notification Toast -->
    <div id="toast">Notifikasi</div>

    <!-- Scripts -->
    <script>
        // --- State Management ---
        let currentView = 'storefront';
        let isLoggedIn = false;
        
        // Data Produk Inovasi Terbaru (Berdasarkan Tren 2026)
        const initialProducts = [
            {
                id: 1,
                name: "Samsung Galaxy Z TriFold",
                category: "Smartphone",
                price: 36000000,
                isPromo: true,
                promoPrice: 33500000,
                image: "https://placehold.co/600x400/1e3a8a/ffffff?text=Galaxy+Z+TriFold+2026",
                desc: "Inovasi revolusioner ponsel dengan dua engsel layar lipat tanpa crease (garis lipatan). Bisa bertransformasi dari ponsel tebal menjadi tablet raksasa."
            },
            {
                id: 2,
                name: "HUAWEI MatePad Air (2026)",
                category: "Tablet",
                price: 11500000,
                isPromo: false,
                promoPrice: 0,
                image: "https://placehold.co/600x400/0f172a/ffffff?text=MatePad+Air+2026",
                desc: "Tablet ultra-tipis (5,3mm) dan super ringan (509g). Ditenagai kemampuan AI setingkat PC untuk produktivitas maksimal di mana saja."
            },
            {
                id: 3,
                name: "Kulkas Pintar AI 4 Pintu",
                category: "Smart Home",
                price: 24500000,
                isPromo: true,
                promoPrice: 21900000,
                image: "https://placehold.co/600x400/111827/ffffff?text=Smart+Kulkas+AI",
                desc: "Kulkas cerdas dengan AI Vision dan layar tablet. Mampu mengenali bahan makanan, merekomendasikan resep, dan mendeteksi stok yang menipis secara otomatis."
            },
            {
                id: 4,
                name: "TCL 65\" Mini LED Google TV",
                category: "TV & Audio",
                price: 16000000,
                isPromo: true,
                promoPrice: 9900000,
                image: "https://placehold.co/600x400/831843/ffffff?text=TCL+Mini+LED+TV",
                desc: "Smart TV dengan teknologi QLED dan Mini LED. Memberikan warna tajam dan kontras sempurna. (Promo Spesial Diskon Heboh!)"
            },
            {
                id: 5,
                name: "Laptop AI Core Ultra Series 3",
                category: "Laptop",
                price: 28000000,
                isPromo: false,
                promoPrice: 0,
                image: "https://placehold.co/600x400/1e40af/ffffff?text=AI+Core+Ultra+Laptop",
                desc: "Ditenagai prosesor Intel terbaru dengan arsitektur NPU yang didedikasikan penuh untuk memproses kecerdasan buatan dengan kecepatan kilat."
            }
        ];

        // Load products from localStorage or use initial data
        let products = JSON.parse(localStorage.getItem('electrohub_products_2026')) || initialProducts;

        // --- Utility Functions ---

        // Format currency (Rupiah)
        const formatRupiah = (number) => {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0
            }).format(number);
        };

        // Show toast notification
        const showToast = (message, type = 'success') => {
            const toast = document.getElementById("toast");
            toast.textContent = message;
            toast.className = `show ${type}`;
            setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 3000);
        };

        // --- UI Navigation ---
        
        function updateAuthUI() {
            const elementsToHideWhenLoggedOut = [
                'nav-admin-dashboard', 'nav-admin-logout',
                'mobile-nav-admin-dashboard', 'mobile-nav-admin-logout'
            ];
            const elementsToHideWhenLoggedIn = [
                'nav-admin-login', 'mobile-nav-admin-login'
            ];

            if (isLoggedIn) {
                elementsToHideWhenLoggedOut.forEach(id => document.getElementById(id)?.classList.remove('hidden'));
                elementsToHideWhenLoggedIn.forEach(id => document.getElementById(id)?.classList.add('hidden'));
            } else {
                elementsToHideWhenLoggedOut.forEach(id => document.getElementById(id)?.classList.add('hidden'));
                elementsToHideWhenLoggedIn.forEach(id => document.getElementById(id)?.classList.remove('hidden'));
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function switchView(viewName) {
            // Hide all views
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            
            // Check auth for dashboard
            if (viewName === 'admin-dashboard' && !isLoggedIn) {
                viewName = 'admin-login';
            }
            if (viewName === 'admin-login' && isLoggedIn) {
                viewName = 'admin-dashboard';
            }

            // Show selected view
            document.getElementById(`view-${viewName}`).classList.remove('hidden');
            currentView = viewName;

            // Trigger specific view renders
            if (viewName === 'storefront') renderStorefront();
            if (viewName === 'promo') renderPromoView();
            if (viewName === 'admin-dashboard') renderAdminProductList();
            
            // Scroll to top smooth
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // --- Authentication ---
        
        function handleLogin(e) {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;

            // Simple hardcoded auth for demo purposes
            if (user === 'admin' && pass === 'password') {
                isLoggedIn = true;
                updateAuthUI();
                document.getElementById('login-form').reset();
                showToast('Autentikasi berhasil. Selamat datang Admin.', 'success');
                switchView('admin-dashboard');
            } else {
                showToast('Kredensial salah! Silakan coba lagi.', 'error');
            }
        }

        function logout() {
            isLoggedIn = false;
            updateAuthUI();
            showToast('Anda telah keluar dari sistem admin.', 'success');
            switchView('storefront');
        }

        // --- Admin Functions ---

        // Toggle promo price input visibility based on checkbox
        document.getElementById('p-promo').addEventListener('change', function() {
            const container = document.getElementById('promo-price-container');
            const input = document.getElementById('p-promo-price');
            if(this.checked) {
                container.classList.remove('hidden');
                input.required = true;
                container.classList.add('animate-pulse');
                setTimeout(() => container.classList.remove('animate-pulse'), 500);
            } else {
                container.classList.add('hidden');
                input.required = false;
                input.value = '';
            }
        });

        function handleAddProduct(e) {
            e.preventDefault();
            
            const isPromo = document.getElementById('p-promo').checked;
            const price = parseInt(document.getElementById('p-price').value);
            let promoPrice = 0;
            
            if (isPromo) {
                promoPrice = parseInt(document.getElementById('p-promo-price').value);
                if (promoPrice >= price) {
                    showToast('Harga promo harus lebih murah dari harga asli!', 'error');
                    return;
                }
            }

            const newProduct = {
                id: Date.now(), // Generate unique ID
                name: document.getElementById('p-name').value,
                category: document.getElementById('p-category').value,
                price: price,
                isPromo: isPromo,
                promoPrice: promoPrice,
                image: document.getElementById('p-image').value,
                desc: document.getElementById('p-desc').value
            };

            // Add to array (at the top)
            products.unshift(newProduct);
            
            // Save to localStorage
            localStorage.setItem('electrohub_products_2026', JSON.stringify(products));
            
            // Reset form
            document.getElementById('add-product-form').reset();
            document.getElementById('promo-price-container').classList.add('hidden');
            
            // Update UI
            renderAdminProductList();
            showToast('Barang elektronik berhasil dipublikasikan!', 'success');
        }

        function deleteProduct(id) {
            // Delete logic without native confirm() box for iframe safety
            products = products.filter(p => p.id !== id);
            localStorage.setItem('electrohub_products_2026', JSON.stringify(products));
            renderAdminProductList();
            showToast('Produk telah dihapus dari sistem.', 'success');
        }

        function syncToCloud() {
            const btn = document.getElementById('btn-cloud-sync');
            const originalText = btn.innerHTML;
            
            // Set Loading State
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Menyinkronkan...';
            btn.classList.add('opacity-75', 'cursor-not-allowed');
            btn.disabled = true;

            // Simulate network request to Cloud Storage
            setTimeout(() => {
                // Success State
                btn.innerHTML = '<i class="fas fa-check-circle mr-2"></i> Tersinkronisasi';
                btn.classList.remove('bg-indigo-600', 'hover:bg-indigo-700');
                btn.classList.add('bg-green-600', 'hover:bg-green-700');
                
                showToast('Data inventaris berhasil disinkronisasi ke Cloud Server!', 'success');
                
                // Revert to original state after 3 seconds
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.remove('bg-green-600', 'hover:bg-green-700', 'opacity-75', 'cursor-not-allowed');
                    btn.classList.add('bg-indigo-600', 'hover:bg-indigo-700');
                    btn.disabled = false;
                }, 3000);
            }, 1500); // 1.5 seconds loading simulation
        }

        function renderAdminProductList() {
            const tbody = document.getElementById('admin-product-list');
            const emptyState = document.getElementById('admin-empty-state');
            const badge = document.getElementById('product-count-badge');
            
            tbody.innerHTML = '';
            badge.textContent = `${products.length} Barang`;

            if (products.length === 0) {
                tbody.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            tbody.classList.remove('hidden');
            emptyState.classList.add('hidden');

            products.forEach(p => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50 transition";
                tr.innerHTML = `
                    <td class="px-6 py-4">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 h-12 w-12 border border-gray-200 rounded-md overflow-hidden bg-gray-100">
                                <img class="h-12 w-12 object-cover" src="${p.image}" alt="Foto ${p.name}" onerror="this.src='https://placehold.co/100x100?text=No+Img'">
                            </div>
                            <div class="ml-4">
                                <div class="text-sm font-bold text-gray-900 line-clamp-1">${p.name}</div>
                                <div class="text-xs text-blue-600 font-medium uppercase tracking-wider mt-1">${p.category}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        ${p.isPromo 
                            ? `<div class="text-sm font-bold text-red-600">${formatRupiah(p.promoPrice)}</div>
                               <div class="text-xs text-gray-400 line-through">${formatRupiah(p.price)}</div>
                               <span class="mt-1 px-2 inline-flex text-[10px] leading-4 font-bold rounded-sm bg-red-100 text-red-800 border border-red-200">PROMO AKTIF</span>`
                            : `<div class="text-sm font-bold text-gray-900">${formatRupiah(p.price)}</div>
                               <span class="mt-1 px-2 inline-flex text-[10px] leading-4 font-bold rounded-sm bg-gray-100 text-gray-600 border border-gray-200">HARGA NORMAL</span>`
                        }
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <button onclick="deleteProduct(${p.id})" class="text-red-500 hover:text-white bg-red-50 hover:bg-red-600 border border-red-200 hover:border-red-600 px-3 py-1.5 rounded transition inline-flex items-center">
                            <i class="fas fa-trash-alt mr-1"></i> Hapus
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- Storefront Functions ---

        // Generic function to generate product card HTML
        function createProductCardHTML(p) {
            const priceDisplay = p.isPromo 
                ? `<div class="flex items-baseline space-x-2">
                     <span class="text-xl font-black text-red-600">${formatRupiah(p.promoPrice)}</span>
                     <span class="text-sm text-gray-400 line-through font-medium">${formatRupiah(p.price)}</span>
                   </div>`
                : `<span class="text-xl font-black text-blue-900">${formatRupiah(p.price)}</span>`;

            const badge = p.isPromo 
                ? `<div class="absolute top-3 right-3 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded shadow-lg z-10 flex items-center">
                    <i class="fas fa-fire mr-1"></i> PROMO
                   </div>` 
                : '';

            let discountBadge = '';
            if(p.isPromo) {
                const discount = Math.round(((p.price - p.promoPrice) / p.price) * 100);
                discountBadge = `<div class="absolute top-3 left-3 bg-yellow-400 text-yellow-900 text-xs font-extrabold px-2 py-1 rounded shadow-md z-10">HEMAT ${discount}%</div>`;
            }

            return `
                <div class="product-card bg-white rounded-2xl overflow-hidden border border-gray-200 flex flex-col h-full relative group">
                    ${badge}
                    ${discountBadge}
                    <div class="relative pt-[75%] bg-gray-50 overflow-hidden border-b border-gray-100">
                        <img src="${p.image}" alt="Foto ${p.name}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out" onerror="this.src='https://placehold.co/600x400/f3f4f6/a1a1aa?text=No+Photo'">
                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition-all duration-300"></div>
                    </div>
                    <div class="p-5 flex-grow flex flex-col">
                        <div class="text-xs text-blue-600 font-bold uppercase tracking-wider mb-2 flex items-center">
                            <i class="fas fa-tag mr-1 opacity-70"></i> ${p.category}
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 leading-tight">${p.name}</h3>
                        <p class="text-sm text-gray-500 mb-5 line-clamp-3 flex-grow leading-relaxed">${p.desc}</p>
                        <div class="mt-auto border-t border-gray-100 pt-4">
                            <div class="mb-4">
                                ${priceDisplay}
                            </div>
                            <button class="w-full bg-gray-900 hover:bg-blue-600 text-white font-medium py-2.5 px-4 rounded-xl transition-colors duration-300 flex items-center justify-center group-hover:shadow-lg" onclick="showToast('${p.name} ditambahkan ke troli')">
                                <i class="fas fa-cart-plus mr-2"></i> Tambah ke Troli
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderStorefront() {
            const container = document.getElementById('products-container');
            const emptyState = document.getElementById('empty-state');
            
            container.innerHTML = '';
            
            if (products.length === 0) {
                container.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            container.classList.remove('hidden');
            emptyState.classList.add('hidden');

            products.forEach(p => {
                container.innerHTML += createProductCardHTML(p);
            });
        }

        function renderPromoView() {
            const container = document.getElementById('promo-products-container');
            container.innerHTML = '';
            
            // Filter only promo items
            const promoProducts = products.filter(p => p.isPromo);

            if (promoProducts.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-16 bg-white rounded-2xl shadow-sm border border-gray-200">
                        <i class="fas fa-box-open text-5xl text-gray-300 mb-4"></i>
                        <h3 class="text-xl font-bold text-gray-700">Yah, belum ada promo hari ini.</h3>
                        <p class="text-gray-500 mt-2">Cek kembali nanti untuk penawaran menarik dari kami!</p>
                        <button onclick="switchView('storefront')" class="mt-6 px-6 py-2 bg-blue-50 text-blue-600 font-medium rounded-lg hover:bg-blue-100 transition">Lihat Semua Produk</button>
                    </div>`;
                return;
            }

            promoProducts.forEach(p => {
                container.innerHTML += createProductCardHTML(p);
            });
        }

        // --- Initialization ---
        window.onload = () => {
            // Initialize auth UI
            updateAuthUI();
            // Initialize main view
            switchView('storefront');
        };

    </script>
</body>
</html>
