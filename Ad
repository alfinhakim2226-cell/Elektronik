                                Belanja Sekarang
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <div class="flex overflow-x-auto space-x-4 pb-4 no-scrollbar items-center justify-center">
